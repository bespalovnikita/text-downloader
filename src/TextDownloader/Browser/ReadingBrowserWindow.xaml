<Window x:Class="TextDownloader.ReadingBrowserWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Продолжение через браузер" Width="1000" Height="730" MinWidth="620" MinHeight="450"
 Background="#171A20" Foreground="#EEF1F8" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <ResourceDictionary Source="/TextDownloader;component/Styles.xaml"/>
 </Window.Resources>
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <TextBox x:Name="RequestedAddress" IsReadOnly="True" AutomationProperties.Name="Ожидаемая страница"/>
   <TextBlock x:Name="BrowserStatus" Text="Запускаем браузер…" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <Button x:Name="CheckPage" Content="Проверить открытую страницу" Click="OnCheckPage" IsEnabled="False"/>
   <Button x:Name="OpenExpected" Content="Открыть ожидаемую страницу" Click="OnOpenExpected" IsEnabled="False"/>
   <Button Content="Пауза" Click="OnPause"/>
  </WrapPanel>
  <web:WebView2 x:Name="PageView" AutomationProperties.Name="Страница в браузере"/>
 </DockPanel>
</Window>
