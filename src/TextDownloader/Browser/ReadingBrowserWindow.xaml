<Window x:Class="TextDownloader.ReadingBrowserWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:web="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="Продолжение через браузер" Width="1000" Height="730" MinWidth="620" MinHeight="450"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <ResourceDictionary Source="/TextDownloader;component/Styles.xaml"/>
 </Window.Resources>
 <DockPanel Margin="16">
  <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource OutlineBrush}"
          BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
   <StackPanel>
    <Label Content="Ожидаемая страница" Target="{Binding ElementName=RequestedAddress}"
           FontWeight="SemiBold" Padding="0,0,0,6"/>
    <DockPanel>
     <Button x:Name="OpenExpected" DockPanel.Dock="Right" Content="Открыть" Click="OnOpenExpected" IsEnabled="False"
             AutomationProperties.Name="Открыть ожидаемую страницу" Margin="8,0,0,0"/>
     <TextBox x:Name="RequestedAddress" IsReadOnly="True"/>
    </DockPanel>
    <TextBlock x:Name="BrowserStatus" Text="Запускаем браузер…" Foreground="{StaticResource MutedBrush}"
               TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel>
  </Border>
  <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <WrapPanel VerticalAlignment="Center">
    <Button x:Name="OpenSignIn" Content="Открыть страницу входа" Click="OnOpenSignIn" Visibility="Collapsed" Margin="0,3,6,3"/>
    <Button x:Name="FillSignIn" Content="Подставить логин и пароль" Click="OnFillSignIn" Visibility="Collapsed" Margin="0,3,6,3"/>
   </WrapPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Content="Пауза" Click="OnPause" Margin="0,0,6,0"/>
    <Button x:Name="CheckPage" Content="Проверить открытую страницу" Click="OnCheckPage" IsEnabled="False"
            Style="{StaticResource PrimaryButton}" Margin="0"/>
   </StackPanel>
  </Grid>
  <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1">
   <web:WebView2 x:Name="PageView" AutomationProperties.Name="Страница в браузере"/>
  </Border>
 </DockPanel>
</Window>
