<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TextDownloader</AssemblyName>
    <RootNamespace>TextDownloader</RootNamespace>
    <ApplicationIcon>../../assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TextDownloader.UiTests" />
    <InternalsVisibleTo Include="TextDownloader.UpdateProcessTests" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <ProjectReference Include="../TextDownloader.Core/TextDownloader.Core.csproj" />
    <Content Include="../../assets/app.ico" Link="assets/app.ico" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
