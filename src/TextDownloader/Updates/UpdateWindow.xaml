<Window x:Class="TextDownloader.Updates.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Обновления — Text Downloader" Width="600" Height="370" MinWidth="520" MinHeight="340"
 WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize"
 Background="#111318" Foreground="#EEF1F8" FontFamily="Segoe UI" Closing="OnClosing">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/TextDownloader;component/Styles.xaml" />
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Обновление Text Downloader" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
  <Grid Grid.Row="1" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Текущая версия" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CurrentVersionText" Text="{Binding CurrentVersion}" FontSize="20" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Доступная версия" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AvailableVersionText" Text="{Binding AvailableVersion}" FontSize="20" Margin="0,4,0,0"/></StackPanel>
  </Grid>
  <StackPanel Grid.Row="2">
   <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="100" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}"/>
   <TextBlock Text="{Binding TransferText}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="3" Margin="0,12,0,12">
   <TextBlock x:Name="UpdateStatusText" Text="{Binding Status}" TextWrapping="Wrap"/>
   <TextBlock Text="{Binding InstallBlockReason}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </StackPanel>
  <WrapPanel Grid.Row="4" HorizontalAlignment="Right">
   <Button x:Name="CheckButton" Content="Проверить" Click="OnCheck" IsEnabled="{Binding CanCheck}"/>
   <Button x:Name="CancelOperationButton" Content="Отменить" Click="OnCancel" IsEnabled="{Binding CanCancel}"/>
   <Button x:Name="InstallButton" Content="Обновить и перезапустить" Background="{StaticResource AccentBrush}" Click="OnInstall" IsEnabled="{Binding CanInstall}"/>
  </WrapPanel>
 </Grid>
</Window>
