<Window x:Class="TextDownloader.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:TextDownloader"
 xmlns:core="clr-namespace:TextDownloader.Core;assembly=TextDownloader.Core"
 Title="Text Downloader" Width="1260" Height="820" MinWidth="880" MinHeight="600"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True"
 WindowStartupLocation="CenterScreen" AllowDrop="True"
 Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing" StateChanged="OnStateChanged">
 <Window.InputBindings>
  <KeyBinding Key="F" Modifiers="Control" Command="Find"/>
 </Window.InputBindings>
 <Window.CommandBindings>
  <CommandBinding Command="Find" CanExecute="OnCanFindQueue" Executed="OnFindQueue"/>
 </Window.CommandBindings>
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Styles.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <BooleanToVisibilityConverter x:Key="ShowWhenTrue"/>
   <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
   </Style>
   <Style x:Key="Surface" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
   </Style>
   <Style x:Key="OptionalText" TargetType="TextBlock">
    <Style.Triggers>
     <Trigger Property="Text" Value="">
      <Setter Property="Visibility" Value="Collapsed"/>
     </Trigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource OptionalText}">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
   </Style>
   <Style x:Key="SectionExpander" TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   </Style>
  </ResourceDictionary>
 </Window.Resources>

 <Grid Margin="20,14,20,16">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Grid Margin="0,0,0,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,8">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button x:Name="AuthorizationButton" Content="Авторизация сайтов…" Click="OnSiteAuthorization"
             IsEnabled="{Binding CanEditSettings}"/>
     <Button x:Name="HistoryButton" Content="История…" Click="OnHistory"/>
     <Button x:Name="UpdateButton" Content="Обновления…" Click="OnUpdate" IsEnabled="{Binding CanOpenUpdates}" Margin="3,0,0,0"/>
    </StackPanel>
    <Label Content="_Ссылки на произведения" Target="{Binding ElementName=UrlInput}"
           Foreground="{StaticResource TextBrush}" FontSize="20" FontWeight="SemiBold"
           Padding="0" VerticalAlignment="Center"/>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="*"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <TextBox x:Name="UrlInput" IsEnabled="{Binding CanReceiveInput}" MinHeight="36"
             KeyDown="OnUrlKeyDown" AutomationProperties.HelpText="Введите ссылку на поддерживаемое произведение и нажмите Enter."
             ToolTip="Ссылки на произведения и страницы чтения"/>
    <Button x:Name="AddButton" Grid.Column="1" Content="Добавить" Style="{StaticResource PrimaryButton}"
            IsEnabled="{Binding CanReceiveInput}" Click="OnAdd" Margin="8,0,0,0"/>
    <Button x:Name="PasteButton" Grid.Column="2" Content="Добавить из буфера"
            IsEnabled="{Binding CanReceiveInput}" Click="OnPaste" Margin="6,0,0,0"/>
    <Button x:Name="LoadListButton" Grid.Column="3" Content="Открыть список…"
            IsEnabled="{Binding CanReceiveInput}" Click="OnLoadList" Margin="6,0,0,0"/>
   </Grid>
  </Grid>

  <Border Grid.Row="1" Style="{StaticResource Surface}" Margin="0,0,0,12" Padding="12,8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="Auto"/><ColumnDefinition Width="112"/><ColumnDefinition Width="Auto"/>
     <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Label Content="Формат" Target="{Binding ElementName=FormatCombo}" Padding="0,0,8,0" VerticalAlignment="Center"/>
    <ComboBox x:Name="FormatCombo" Grid.Column="1" SelectedValuePath="Tag"
              SelectedValue="{Binding Format,Mode=TwoWay}" IsEnabled="{Binding CanEditSettings}">
     <ComboBoxItem Tag="{x:Static core:BookFormat.Both}" Content="EPUB + FB2"/>
     <ComboBoxItem Tag="{x:Static core:BookFormat.Epub}" Content="EPUB"/>
     <ComboBoxItem Tag="{x:Static core:BookFormat.Fb2}" Content="FB2"/>
    </ComboBox>
    <Label Grid.Column="2" Content="Папка книг" Target="{Binding ElementName=OutputInput}"
           Padding="14,0,8,0" VerticalAlignment="Center"/>
    <TextBox x:Name="OutputInput" Grid.Column="3" Text="{Binding OutputDirectory,UpdateSourceTrigger=PropertyChanged}"
             ToolTip="{Binding OutputDirectory}" IsReadOnly="{Binding IsBusy}" IsEnabled="{Binding CanReceiveInput}"/>
    <Button x:Name="BrowseButton" Grid.Column="4" Content="Выбрать…" Click="OnBrowse"
            IsEnabled="{Binding CanEditSettings}" AutomationProperties.Name="Выбрать папку книг" Margin="6,0,0,0"/>
    <Button x:Name="OpenFolderButton" Grid.Column="5" Content="Открыть" Click="OnOpenFolder"
            AutomationProperties.Name="Открыть папку книг" Margin="6,0,0,0"/>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Margin="0,6,0,0">
     <Expander x:Name="SettingsExpander" Header="Дополнительные настройки" Style="{StaticResource SectionExpander}">
      <StackPanel Margin="0,4,0,0" TextElement.FontWeight="Normal">
       <WrapPanel>
        <CheckBox x:Name="AdultCheck" Content="Мне исполнилось 18 лет — подтверждать предупреждение сайта"
                  IsChecked="{Binding ConfirmAdult,Mode=TwoWay}" IsEnabled="{Binding CanEditSettings}"/>
        <CheckBox x:Name="RefreshCheck" Content="Скачать заново (без кеша)" Margin="16,0,0,0"
                  IsChecked="{Binding RefreshCache,Mode=TwoWay}" IsEnabled="{Binding CanEditSettings}"/>
        <CheckBox Content="Сворачивать в трей" Margin="16,0,0,0"
                  IsChecked="{Binding MinimizeToTray,Mode=TwoWay}"/>
       </WrapPanel>
       <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
        <Label Content="Задержка между запросами, с" Target="{Binding ElementName=PageDelayInput}"
               Padding="0,0,8,0" VerticalAlignment="Center"/>
        <TextBox x:Name="PageDelayInput" Width="84" Text="{Binding PageDelayText,UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CanEditSettings}"/>
       </StackPanel>
      </StackPanel>
     </Expander>
     <TextBlock Text="{Binding PageDelayError}" Style="{StaticResource OptionalText}"
                Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
   </Grid>
  </Border>

  <Grid x:Name="WorkspaceGrid" Grid.Row="2" SizeChanged="OnWorkspaceSizeChanged">
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="QueueColumn" Width="*" MinWidth="440"/>
    <ColumnDefinition x:Name="SplitterColumn" Width="12"/>
    <ColumnDefinition x:Name="PreviewColumn" Width="360" MinWidth="300"/>
   </Grid.ColumnDefinitions>

   <Border Style="{StaticResource Surface}">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <DockPanel Margin="14,8,12,8">
      <Button x:Name="QueueActionsButton" DockPanel.Dock="Right" Content="Действия  ▾"
              AutomationProperties.Name="Действия с очередью" Click="OnQueueActions"
              IsEnabled="{Binding HasQueueItems}" Margin="0">
       <Button.ContextMenu>
        <ContextMenu Placement="Bottom" Style="{StaticResource QueueActionsMenu}"
                     DataContext="{Binding PlacementTarget.DataContext,RelativeSource={RelativeSource Self}}">
         <MenuItem x:Name="CopyQueueUrlItem" Header="Копировать ссылку" Style="{StaticResource QueueActionItem}"
                   Click="OnCopySelectedUrl" IsEnabled="{Binding CanCopySelectedUrl}"/>
         <MenuItem x:Name="RepeatSelectedItem" Header="Повторить выбранные" Style="{StaticResource QueueActionItem}"
                   Click="OnRepeatSelected" IsEnabled="{Binding CanRepeatSelected}"/>
         <MenuItem Header="Удалить выбранные" Style="{StaticResource QueueActionItem}" Click="OnRemove"
                   IsEnabled="{Binding CanRemoveSelected}"/>
         <MenuItem Header="Убрать готовые" Style="{StaticResource QueueActionItem}" Click="OnClearCompleted"
                   IsEnabled="{Binding CanClearCompleted}"/>
        </ContextMenu>
       </Button.ContextMenu>
      </Button>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="Очередь" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="{Binding QueueCountText}" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </DockPanel>

     <DockPanel Grid.Row="1" Margin="12,0,12,8" IsEnabled="{Binding CanReceiveInput}" KeyboardNavigation.TabNavigation="Local"
                Visibility="{Binding HasQueueItems,Converter={StaticResource ShowWhenTrue}}">
      <Button x:Name="ResetQueueFiltersButton" DockPanel.Dock="Right" Content="Сбросить" Click="OnResetQueueFilters"
              AutomationProperties.Name="Сбросить поиск и фильтр очереди" IsEnabled="{Binding HasQueueFilters}" Margin="8,0,0,0" TabIndex="2"/>
      <ComboBox x:Name="QueueStatusFilterCombo" DockPanel.Dock="Right" Width="140" Margin="8,0,0,0" TabIndex="1"
                AutomationProperties.Name="Фильтр очереди по статусу" SelectedValuePath="Tag"
                SelectedValue="{Binding StatusFilter,Mode=TwoWay}">
       <ComboBoxItem Content="Все статусы" Tag="{x:Static local:QueueStatusFilter.All}"/>
       <ComboBoxItem Content="Текущие" Tag="{x:Static local:QueueStatusFilter.Current}"/>
       <ComboBoxItem Content="Готовые" Tag="{x:Static local:QueueStatusFilter.Completed}"/>
       <ComboBoxItem Content="Ошибки и отмена" Tag="{x:Static local:QueueStatusFilter.NeedsAttention}"/>
      </ComboBox>
      <Label DockPanel.Dock="Left" Content="Найти" Target="{Binding ElementName=QueueSearchInput}"
             Padding="0,0,8,0" VerticalAlignment="Center"/>
      <TextBox x:Name="QueueSearchInput" Text="{Binding QueueSearchText,UpdateSourceTrigger=PropertyChanged}" TabIndex="0"
               ToolTip="Поиск по названию или ссылке (Ctrl+F)" AutomationProperties.Name="Поиск в очереди по названию или ссылке"/>
     </DockPanel>

     <DataGrid x:Name="QueueGrid" Grid.Row="2" ItemsSource="{Binding QueueView}" SelectedItem="{Binding SelectedItem,Mode=TwoWay}"
               IsEnabled="{Binding CanReceiveInput}" Visibility="{Binding HasVisibleQueueItems,Converter={StaticResource ShowWhenTrue}}"
               IsSynchronizedWithCurrentItem="False"
               AutomationProperties.Name="Очередь загрузок" SelectionChanged="OnQueueSelectionChanged"
               MouseDoubleClick="OnQueueDoubleClick" CanUserReorderColumns="False" CanUserSortColumns="False">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Произведение" Binding="{Binding DisplayTitle}" Width="*" MinWidth="160"
                           ElementStyle="{StaticResource GridTextStyle}"/>
       <DataGridTextColumn Header="Прогресс" Binding="{Binding PageProgress}" Width="105"
                           ElementStyle="{StaticResource GridTextStyle}"/>
       <DataGridTemplateColumn Header="Статус" Width="112">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <TextBlock Text="{Binding StatusText}">
           <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
             <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueStatus.Running}">
               <Setter Property="Foreground" Value="{StaticResource FocusBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueStatus.Completed}">
               <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueStatus.Failed}">
               <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Status}" Value="{x:Static local:QueueStatus.Paused}">
               <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
              </DataTrigger>
             </Style.Triggers>
            </Style>
           </TextBlock.Style>
          </TextBlock>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>

     <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
      <StackPanel.Style>
       <Style TargetType="StackPanel">
        <Style.Triggers>
         <DataTrigger Binding="{Binding HasVisibleQueueItems}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </StackPanel.Style>
      <TextBlock FontSize="17" FontWeight="SemiBold" TextAlignment="Center">
       <TextBlock.Style>
        <Style TargetType="TextBlock">
         <Setter Property="Text" Value="Очередь пуста"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding HasQueueItems}" Value="True">
           <Setter Property="Text" Value="Ничего не найдено"/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
      <TextBlock TextAlignment="Center" Margin="0,6,0,0">
       <TextBlock.Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
         <Setter Property="Text" Value="Добавьте ссылку или перетащите сюда список .txt"/>
         <Style.Triggers>
          <DataTrigger Binding="{Binding HasQueueItems}" Value="True">
           <Setter Property="Text" Value="Измените запрос или сбросьте фильтры."/>
          </DataTrigger>
         </Style.Triggers>
        </Style>
       </TextBlock.Style>
      </TextBlock>
     </StackPanel>

     <Border Grid.Row="3" BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,1,0,0" Padding="12,4,12,6">
      <Expander x:Name="JournalExpander" Header="Журнал" Style="{StaticResource SectionExpander}">
       <Grid Margin="0,4,0,0" TextElement.FontWeight="Normal">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <WrapPanel Margin="0,0,0,6">
         <ComboBox x:Name="JournalLevelCombo" Width="150" AutomationProperties.Name="Уровень журнала"
                   SelectedValuePath="Tag" SelectedValue="{Binding JournalLevel,Mode=TwoWay}">
          <ComboBoxItem Tag="{x:Static core:DownloadLogLevel.Detail}" Content="Подробно"/>
          <ComboBoxItem Tag="{x:Static core:DownloadLogLevel.Information}" Content="Обычный"/>
          <ComboBoxItem Tag="{x:Static core:DownloadLogLevel.Warning}" Content="Предупреждения"/>
          <ComboBoxItem Tag="{x:Static core:DownloadLogLevel.Error}" Content="Только ошибки"/>
         </ComboBox>
         <CheckBox x:Name="JournalSelectedCheck" Content="Выбранная загрузка" Margin="8,0"
                   IsChecked="{Binding JournalSelectedOnly,Mode=TwoWay}"/>
         <Button Content="Сохранить журнал…" Click="OnSaveJournal" Margin="0"/>
        </WrapPanel>
        <ListBox x:Name="JournalBox" Grid.Row="1" Height="96" ItemsSource="{Binding JournalView}" SelectionMode="Extended"
                 Background="{StaticResource FieldBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource OutlineBrush}" Padding="4"
                 AutomationProperties.Name="Записи журнала" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
         <ListBox.CommandBindings>
          <CommandBinding Command="Copy" CanExecute="OnCanCopyJournal" Executed="OnCopyJournal"/>
         </ListBox.CommandBindings>
         <ListBox.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding Line}" TextWrapping="Wrap"/></DataTemplate>
         </ListBox.ItemTemplate>
        </ListBox>
       </Grid>
      </Expander>
     </Border>
    </Grid>
   </Border>

   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeWE"
                 DragCompleted="OnSplitterChanged" KeyUp="OnSplitterKeyUp"
                 AutomationProperties.Name="Ширина предпросмотра"/>

   <Border Grid.Column="2" Style="{StaticResource Surface}">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Предпросмотр" Style="{StaticResource SectionTitle}" Margin="14,12,14,8"/>
     <ScrollViewer x:Name="PreviewScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="14,0,14,12">
       <TextBlock x:Name="PreviewTitleText" Text="{Binding PreviewTitle}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding PreviewMetadata}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
       <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0"/>

       <Border BorderBrush="{StaticResource OutlineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,8" Padding="0,10,0,0">
        <Border.Style>
         <Style TargetType="Border">
          <Style.Triggers>
           <DataTrigger Binding="{Binding RecoveryItem}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
          </Style.Triggers>
         </Style>
        </Border.Style>
        <StackPanel>
         <TextBlock Text="Продолжение загрузки" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding RecoveryItem.DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding RecoveryItem.DisplayTitle}" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding RecoveryItem.Message}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
         <Label Content="Последняя успешно загруженная страница" Target="{Binding ElementName=LastSuccessfulPageInput}" Padding="0,8,0,3"/>
         <DockPanel>
          <Button DockPanel.Dock="Right" Content="Копировать" Click="OnCopyLastPage" Margin="6,0,0,0">
           <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
             <Style.Triggers>
              <DataTrigger Binding="{Binding RecoveryItem.Checkpoint.LastSuccessfulPageUrl}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
             </Style.Triggers>
            </Style>
           </Button.Style>
          </Button>
          <TextBox x:Name="LastSuccessfulPageInput" IsReadOnly="True"
                   Text="{Binding RecoveryItem.Checkpoint.LastSuccessfulPageUrl.AbsoluteUri,Mode=OneWay,TargetNullValue='Ещё не загружена',FallbackValue='Ещё не загружена'}"/>
         </DockPanel>
         <Label Content="Адрес страницы для продолжения" Target="{Binding ElementName=RecoveryPageInput}" Padding="0,8,0,3"/>
         <TextBox x:Name="RecoveryPageInput" IsEnabled="{Binding CanEditSettings}"/>
         <TextBlock x:Name="RecoveryError" Foreground="{StaticResource DangerBrush}" Style="{StaticResource OptionalText}" TextWrapping="Wrap"/>
         <WrapPanel Margin="0,6,0,0">
          <Button x:Name="UseRecoveryPageButton" Content="Принять адрес" Margin="0,0,6,6"
                  Click="OnUseRecoveryPage" IsEnabled="{Binding CanEditSettings}"/>
          <Button Content="Открыть в браузере" Click="OnOpenRecoveryPage" IsEnabled="{Binding CanEditSettings}"
                  Visibility="{Binding CanImportRecoveryPage,Converter={StaticResource ShowWhenTrue}}" Margin="0,0,6,6"/>
          <Button x:Name="ImportRecoveryPageButton" Content="Добавить HTML…" Click="OnImportRecoveryPage"
                  IsEnabled="{Binding CanEditSettings}"
                  Visibility="{Binding CanImportRecoveryPage,Converter={StaticResource ShowWhenTrue}}" Margin="0,0,6,6"
                  ToolTip="Сохраните HTML страницы чтения в браузере и выберите этот файл."/>
         </WrapPanel>
         <Button x:Name="BrowserRecoveryButton" Content="Продолжить через браузер" Click="OnBrowserRecovery"
                 IsEnabled="{Binding CanStartSession}" HorizontalAlignment="Left" Margin="0,0,0,6"
                 Visibility="{Binding CanRecoverInBrowser,Converter={StaticResource ShowWhenTrue}}"/>
        </StackPanel>
       </Border>

       <TextBox x:Name="PreviewBody" Text="{Binding PreviewText,Mode=OneWay}" IsReadOnly="True"
                AutomationProperties.Name="Фрагмент произведения" TextWrapping="Wrap" FontSize="14"
                Background="Transparent" BorderBrush="Transparent" Padding="2,0" Margin="0,10,0,0"
                VerticalContentAlignment="Top">
        <TextBox.Style>
         <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
          <Setter Property="Template">
           <Setter.Value>
            <ControlTemplate TargetType="TextBox">
             <Border x:Name="ReadingFrame" Padding="{TemplateBinding Padding}" BorderThickness="1"
                     BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}" CornerRadius="4">
              <AdornerDecorator x:Name="PART_ContentHost"/>
             </Border>
             <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
               <Setter TargetName="ReadingFrame" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
              </Trigger>
             </ControlTemplate.Triggers>
            </ControlTemplate>
           </Setter.Value>
          </Setter>
          <Style.Triggers>
           <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
          </Style.Triggers>
         </Style>
        </TextBox.Style>
       </TextBox>
      </StackPanel>
     </ScrollViewer>
     <WrapPanel Grid.Row="2" Margin="10,2,10,8" Visibility="{Binding HasSelection,Converter={StaticResource ShowWhenTrue}}">
      <Button x:Name="PreviewButton" IsEnabled="{Binding CanReceiveInput}" Content="Обновить сведения" Click="OnPreview"/>
      <Button x:Name="OpenBookButton" Content="Открыть книгу" Click="OnOpenBook"
              Visibility="{Binding HasSelectedBook,Converter={StaticResource ShowWhenTrue}}"/>
      <Button Content="Показать в папке" Click="OnShowBook"
              Visibility="{Binding HasSelectedBook,Converter={StaticResource ShowWhenTrue}}"/>
     </WrapPanel>
    </Grid>
   </Border>
  </Grid>

  <DockPanel Grid.Row="3" Margin="0,12,0,0">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
    <Button x:Name="RetryButton" Content="Повторить ошибки" Click="OnRetry"
            ToolTip="Повторить все задания с ошибкой или отменой"
            IsEnabled="{Binding CanRetry}" Visibility="{Binding CanRetry,Converter={StaticResource ShowWhenTrue}}"/>
    <Button x:Name="StartButton" Content="{Binding StartLabel}" Click="OnStart" IsEnabled="{Binding CanStart}" Margin="4,0,0,0"
            ToolTip="Запустить все ожидающие и приостановленные задания">
     <Button.Style>
      <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers>
      </Style>
     </Button.Style>
    </Button>
    <Button x:Name="CancelButton" Content="Отменить загрузку" Click="OnCancel" IsEnabled="{Binding IsBusy}"
            Visibility="{Binding IsBusy,Converter={StaticResource ShowWhenTrue}}"/>
    <Button x:Name="PauseButton" Content="Пауза" Click="OnPause" IsEnabled="{Binding IsBusy}"
            Style="{StaticResource PrimaryButton}" Margin="4,0,0,0"
            Visibility="{Binding IsBusy,Converter={StaticResource ShowWhenTrue}}"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Center">
    <TextBlock x:Name="StatusBlock" Text="{Binding CurrentStatus}" Style="{StaticResource Hint}"
               ToolTip="{Binding CurrentStatus}" TextTrimming="CharacterEllipsis" MaxHeight="44"/>
    <ProgressBar x:Name="CurrentProgress" Minimum="0" Maximum="100" Value="{Binding ActiveItem.Percent,Mode=OneWay,FallbackValue=0}"
                 AutomationProperties.Name="Прогресс текущей загрузки" Margin="0,6,0,0"
                 Visibility="{Binding IsBusy,Converter={StaticResource ShowWhenTrue}}"/>
   </StackPanel>
  </DockPanel>
 </Grid>
</Window>
